# Generated XML documentation
UniText.xml

# User-specific settings (created from Defaults/ template)
Resources/UniTextSettings.asset
Resources/UniTextSettings.asset.meta


# IDE
.idea/
*.user
*.suo

# OS
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp

# Native build outputs (Phase 0 — NativeSource~ CMake project)
# Never commit build dirs or FetchContent'd upstream sources; only the rebuilt
# Plugins/**/unitext_native* binaries (added explicitly) are tracked.
NativeSource~/build/
NativeSource~/build-bl/
NativeSource~/build-clean/
NativeSource~/tools/
NativeSource~/tests/renders/
NativeSource~/out/
NativeSource~/**/_deps/
NativeSource~/tests/**/bin/
NativeSource~/tests/**/obj/
NativeSource~/tests/bin/
NativeSource~/tests/obj/
NativeSource~/tests/fonts/*.ttf
NativeSource~/tests/fonts/*.otf
!NativeSource~/tests/fonts/OFL.txt
# RobotoFlex-VF is the variable font the parity harness needs for the mm_var /
# variations checks. Track it so CI has a real variable font without a network
# fetch (OFL, license text tracked above). Other fetched fonts stay ignored.
!NativeSource~/tests/fonts/RobotoFlex-VF.ttf

# MSDF test visual-evidence output (regenerated by tests; not source)
Tests/Editor/Output/
Tests/Editor/Output.meta

# Session runtime files (not project deliverables)
.kiro/settings/

# Embedded benchmark Unity project (Benchmarks~/): ignore generated/transient
# output, keep Assets / Packages / ProjectSettings source + the committed results.
Benchmarks~/Library/
Benchmarks~/Temp/
Benchmarks~/Obj/
Benchmarks~/obj/
Benchmarks~/Logs/
Benchmarks~/UserSettings/
Benchmarks~/Build/
Benchmarks~/Builds/
Benchmarks~/*.csproj
Benchmarks~/*.sln
Benchmarks~/.utmp/
Benchmarks~/.gradle/
Benchmarks~/.vs/
# Keep committed results + raw JSON under Benchmarks~/Results/ (added explicitly).

# TMP imported examples (bulky, not a deliverable)
Benchmarks~/Assets/TextMesh Pro/Examples & Extras/
