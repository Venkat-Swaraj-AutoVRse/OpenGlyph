# Generated XML documentation
UniText.xml

# User-specific settings (created from Defaults/ template)
Resources/UniTextSettings.asset
Resources/UniTextSettings.asset.meta


# IDE
.idea/
*.user
*.suo

# OS
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp

# Native build outputs (Phase 0 — NativeSource~ CMake project)
# Never commit build dirs or FetchContent'd upstream sources; only the rebuilt
# Plugins/**/unitext_native* binaries (added explicitly) are tracked.
NativeSource~/build/
NativeSource~/build-bl/
NativeSource~/build-clean/
NativeSource~/tools/
NativeSource~/tests/renders/
NativeSource~/out/
NativeSource~/**/_deps/
NativeSource~/tests/**/bin/
NativeSource~/tests/**/obj/
NativeSource~/tests/bin/
NativeSource~/tests/obj/
NativeSource~/tests/fonts/*.ttf
NativeSource~/tests/fonts/*.otf
!NativeSource~/tests/fonts/OFL.txt
# RobotoFlex-VF is the variable font the parity harness needs for the mm_var /
# variations checks. Track it so CI has a real variable font without a network
# fetch (OFL, license text tracked above). Other fetched fonts stay ignored.
!NativeSource~/tests/fonts/RobotoFlex-VF.ttf
